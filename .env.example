# Local development: a SQLite file in the project root
NUXT_DATABASE_URL=file:local.db

# Production (e.g. Turso): libsql://<your-db>.turso.io
# NUXT_DATABASE_AUTH_TOKEN=

# Encrypts the session cookie. At least 32 characters.
# In development nuxt-auth-utils generates one into .env automatically.
# Production: generate with `openssl rand -base64 32`
# NUXT_SESSION_PASSWORD=
